<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Snap‑Style Login</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- 1️⃣ Google font & Font‑Awesome (for the eye icon) -->
<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      integrity="sha512-xxxx" crossorigin="anonymous" referrerpolicy="no-referrer" />

<style>
/* -------------------------------------------------
   2️⃣ CSS VARIABLES – easy theming
   ------------------------------------------------- */
:root{
    --clr-primary   : #ff5a5f;          /* Snapchat‑ish pink/red */
    --clr-primary-dk: #e04e53;
    --clr-bg-start  : #ff9a9e;
    --clr-bg-end    : #fad0c4;
    --clr-card      : #ffffff;
    --clr-error     : #d93025;
    --clr-muted     : #555555;
    --radius        : 8px;
    --shadow        : 0 4px 12px rgba(0,0,0,.1);
    --font          : 'Roboto', system-ui, sans-serif;
    --transition    : 0.2s ease;
}

/* -------------------------------------------------
   3️⃣ GLOBAL STYLES
   ------------------------------------------------- */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{font-size:16px;font-family:var(--font);background:linear-gradient(135deg,var(--clr-bg-start),var(--clr-bg-end));background-size:400% 400%;animation:bgMove 12s ease infinite;}
@keyframes bgMove{
    0%{background-position:0% 50%}
    50%{background-position:100% 50%}
    100%{background-position:0% 50%}
}
body{min-height:100vh;display:flex;align-items:center;justify-content:center;}

/* -------------------------------------------------
   4️⃣ CARD (FORM CONTAINER)
   ------------------------------------------------- */
.login-card{
    background:var(--clr-card);
    padding:2rem 2.5rem;
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    width:100%;
    max-width:380px;
    text-align:center;
}

/* -------------------------------------------------
   5️⃣ LOGO – animated SVG with gradient fill
   ------------------------------------------------- */
.logo{
    width:80px;height:80px;margin:0 auto 1.5rem;
}
.logo svg{
    width:100%;height:100%;
    animation:logoPulse 3s ease-in-out infinite;
}
@keyframes logoPulse{
    0%,100%{transform:scale(1);}
    50%{transform:scale(1.08);}
}

/* Gradient that slowly rotates */
.logo defs linearGradient{
    animation:gradientRotate 6s linear infinite;
}
@keyframes gradientRotate{
    from{transform:rotate(0deg);}
    to{transform:rotate(360deg);}
}

/* -------------------------------------------------
   6️⃣ FORM ELEMENTS
   ------------------------------------------------- */
h1{font-weight:500;margin-bottom:1rem;color:#333;}
.form-group{margin-bottom:1.25rem;position:relative;text-align:left;}
label{display:block;margin-bottom:0.35rem;font-size:0.95rem;color:var(--clr-muted);}
input{
    width:100%;padding:0.65rem 0.9rem;border:1px solid #ccc;border-radius:4px;
    font-size:1rem;transition:border-color var(--transition),box-shadow var(--transition);
}
input:focus{outline:none;border-color:var(--clr-primary);box-shadow:0 0 0 3px rgba(255,90,95,.15);}
input.invalid{border-color:var(--clr-error);}

.error-msg{
    color:var(--clr-error);font-size:0.85rem;min-height:1em;margin-top:0.25rem;
}

/* Show/Hide password button */
.toggle-pw{
    position:absolute;top:50%;right:0.9rem;transform:translateY(-50%);
    background:none;border:none;cursor:pointer;color:#777;font-size:1rem;
}
.toggle-pw:hover{color:#333;}

/* -------------------------------------------------
   7️⃣ BUTTON & LINKS
   ------------------------------------------------- */
.btn-primary{
    width:100%;padding:0.75rem;background:var(--clr-primary);
    color:#fff;border:none;border-radius:4px;font-size:1rem;font-weight:500;
    cursor:pointer;transition:background var(--transition);
}
.btn-primary:hover{background:var(--clr-primary-dk);}

.extra{margin-top:1rem;font-size:0.9rem;}
.extra a{color:var(--clr-primary);text-decoration:none;}
.extra a:hover{text-decoration:underline;}

/* -------------------------------------------------
   8️⃣ SHAKING ANIMATION (invalid submit)
   ------------------------------------------------- */
@keyframes shake{
    0%,100%{transform:translateX(0);}
    20%{transform:translateX(-8px);}
    40%{transform:translateX(8px);}
    60%{transform:translateX(-5px);}
    80%{transform:translateX(5px);}
}
.shake{animation:shake .4s;}

/* -------------------------------------------------
   9️⃣ RESPONSIVE
   ------------------------------------------------- */
@media(max-width:460px){
    .login-card{padding:1.5rem 1.8rem;}
}
</style>
</head>
<body>

<div class="login-card">
    <!-- 10️⃣ Animated logo -->
    <div class="logo">
        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%"   stop-color="#ff9a9e"/>
                    <stop offset="50%"  stop-color="#fad0c4"/>
                    <stop offset="100%" stop-color="#ff9a9e"/>
                </linearGradient>
            </defs>
            <!-- Very simple “ghost” shape – you can swap this for the real Snap logo -->
            <path d="M32 2c-9.94 0-18 8.06-18 18 0 7.41 4.47 13.73 10.78 16.44L24 62l8-6 8 6-0.78-25.56C45.53 33.73 50 27.41 50 20c0-9.94-8.06-18-18-18z"
                  fill="url(#grad1)"/>
        </svg>
    </div>

    <h1>Log in to Snap‑Style</h1>

    <form id="loginForm" action="/login" method="POST" novalidate autocomplete="on">
        <!-- EMAIL -->
        <div class="form-group">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email"
                   placeholder="you@example.com" required autocomplete="email"
                   aria-label="Email address">
            <small class="error-msg" id="emailError"></small>
        </div>

        <!-- PASSWORD + eye icon -->
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password"
                   placeholder="••••••••" required minlength="6"
                   autocomplete="current-password" aria-label="Password">
            <button type="button" class="toggle-pw" aria-label="Show password">
                <i class="fa-regular fa-eye"></i>
            </button>
            <small class="error-msg" id="passwordError"></small>
        </div>

        <!-- Remember me -->
        <div class="form-group" style="display:flex;align-items:center;gap:0.5rem;">
            <input type="checkbox" id="remember" name="remember" autocomplete="on">
            <label for="remember" style="margin:0;font-size:0.9rem;color:var(--clr-muted);">
                Remember me
            </label>
        </div>

        <button type="submit" class="btn-primary">Log In</button>

        <p class="extra">
            <a href="#">Forgot password?</a> •
            <a href="#">Create an account</a>
        </p>
    </form>
</div>

<script>
/* -------------------------------------------------
   11️⃣ JavaScript – validation, show/hide pw,
        shake on error
   ------------------------------------------------- */
document.addEventListener('DOMContentLoaded', () => {
    const form        = document.getElementById('loginForm');
    const emailInput  = document.getElementById('email');
    const pwdInput    = document.getElementById('password');
    const emailErr    = document.getElementById('emailError');
    const pwdErr      = document.getElementById('passwordError');
    const toggleBtn   = document.querySelector('.toggle-pw');
    const card        = document.querySelector('.login-card');

    // ---------- Show / hide password ----------
    let visible = false;
    toggleBtn.addEventListener('click', () => {
        visible = !visible;
        pwdInput.type = visible ? 'text' : 'password';
        toggleBtn.innerHTML = visible
            ? '<i class="fa-regular fa-eye-slash"></i>'
            : '<i class="fa-regular fa-eye"></i>';
        toggleBtn.setAttribute('aria-label', visible ? 'Hide password' : 'Show password');
    });

    // ---------- Live validation ----------
    emailInput.addEventListener('input', () => {
        if (emailInput.checkValidity()) {
            emailInput.classList.remove('invalid');
            emailErr.textContent = '';
        }
    });
    pwdInput.addEventListener('input', () => {
        if (pwdInput.value.length >= 6) {
            pwdInput.classList.remove('invalid');
            pwdErr.textContent = '';
        }
    });

    // ---------- Submit handling ----------
    form.addEventListener('submit', (e) => {
        // reset previous errors
        emailInput.classList.remove('invalid');
        pwdInput.classList.remove('invalid');
        emailErr.textContent = '';
        pwdErr.textContent = '';

        let valid = true;

        // Email
        if (!emailInput.value.trim()) {
            emailErr.textContent = 'Email is required.';
            emailInput.classList.add('invalid');
            valid = false;
        } else if (!emailInput.checkValidity()) {
            emailErr.textContent = 'Enter a valid email address.';
            emailInput.classList.add('invalid');
            valid = false;
        }

        // Password
        if (!pwdInput.value) {
            pwdErr.textContent = 'Password is required.';
            pwdInput.classList.add('invalid');
            valid = false;
        } else if (pwdInput.value.length < 6) {
            pwdErr.textContent = 'Password must be at least 6 characters.';
            pwdInput.classList.add('invalid');
            valid = false;
        }

        if (!valid) {
            e.preventDefault();                 // stop real submit
            card.classList.add('shake');        // visual cue
            card.addEventListener('animationend', () => {
                card.classList.remove('shake');
            }, {once:true});
        }
        // If valid – form posts to /login (change as needed)
    });
});
</script>
</body>
</html>